# ---- Chain ----
HSK_RPC_MAINNET=https://mainnet.hsk.xyz
HSK_RPC_TESTNET=https://testnet.hsk.xyz
CHAIN_ID=177                      # 177 mainnet, 133 testnet

# ---- Keys (NEVER commit real values) ----
DEPLOYER_PRIVATE_KEY=             # deploys contracts, owns arena vault
AGENT_PRIVATE_KEY=                # operator EOA only, never owner
KEEPER_PRIVATE_KEY=               # calls halt()
ARENA_OPERATOR_PRIVATE_KEY=       # records arena attempts, pays tier-1 bounties

# ---- LLM ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# ---- Deployed addresses (filled by contracts/script/Deploy.s.sol output) ----
MANDATE_REGISTRY=
POLICY_ENGINE=
VAULT_FACTORY=
AGENT_REGISTRY=
ARENA_BOUNTY=
ARENA_VAULT=
KYC_SBT=                          # unset on mainnet = allowlist fallback

# ---- Agent / keeper ----
AGENT_VAULT=                      # vault the trading agent operates
DRY_RUN=true                      # true = preflight only, never send txs
LOOP_MS=60000                     # agent decision interval
VAULTS=                           # keeper: comma-separated vaults (empty = read factory events)
FACTORY_FROM_BLOCK=
ORACLE_MAX_AGE_SECS=3600
APRO_FEED=                        # optional, defaults to mainnet HSK/USD
AGENT_URL=http://localhost:8787   # web -> agent arena endpoint (pnpm --filter @vyuh/agent serve)
AGENT_PORT=8787
ALLOW_SUBMIT=false                # MCP: allow propose_trade to send txs
START_BLOCK=                      # indexer start block (<= factory deploy block)
V3_FACTORY=                       # testnet only; mainnet uses the known factory

# ---- Services ----
DATABASE_URL=postgres://vyuh:vyuh@localhost:5432/vyuh
INDEXER_URL=http://localhost:42069
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069
NEXT_PUBLIC_CHAIN_ID=177
NEXT_PUBLIC_MANDATE_REGISTRY=        # EIP-712 verifyingContract for mandate signing
NEXT_PUBLIC_ARENA_VAULT=             # console default vault
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
